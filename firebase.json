{
  "hosting": {
    "public": "dist/client",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": "api", "region": "europe-west1" }
    ],
    "predeploy": ["npm run build:client"]
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs20",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "*.log",
      "src/**",
      "dist/client/**",
      "public/**",
      "index.html",
      "vite.config.ts",
      "tsconfig.json",
      "tsconfig.server.json",
      "coverage/**",
      "CLAUDE.md",
      "CHANGELOG.md"
    ],
    "predeploy": ["npm run build:server"]
  }
}
