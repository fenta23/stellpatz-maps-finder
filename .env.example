SERVER_PORT=3000
MAPILLARY_ACCESS_TOKEN=

# Optional: persistenter POI-Cache in Supabase Postgres.
# Ohne diese Variablen nutzt der Server den In-Memory-Cache (Fallback).
# service_role-Key (NICHT der anon-Key!) — nur serverseitig, niemals im Client.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Render Deployment
# Umgebungsvariablen im Render Dashboard setzen:
# https://dashboard.render.com → Dein Service → Environment
