SERVER_PORT=3000
MAPILLARY_ACCESS_TOKEN=

# Firebase Deployment
# Umgebungsvariablen für Cloud Functions werden NICHT aus dieser Datei geladen.
# Stattdessen im Firebase Console setzen:
#   https://console.firebase.google.com → Dein Projekt → Build → Functions
#   → Funktion "api" → Bearbeiten → Umgebungsvariablen
#
# Oder per CLI (Firebase Functions v2 / Secrets):
#   firebase functions:secrets:set MAPILLARY_ACCESS_TOKEN
