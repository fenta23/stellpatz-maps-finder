MAPILLARY_ACCESS_TOKEN=

# Supabase Edge Functions — sekundengenau lokal via supabase CLI.
# Für Produktion als Secrets in Supabase Dashboard setzen.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Client-Auth (Login). Werden zur BUILD-Zeit ins Client-Bundle gebacken (Vite).
# anon-Key — öffentlich, ungefährlich. Ohne diese ist Login ausgeblendet.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# DSGVO-Verantwortlicher (Klarname für Datenschutz/Impressum). Build-Zeit-Env,
# damit der Name nicht im öffentlichen Repo steht — in Prod als GitHub-Secret
# VITE_DSGVO_VERANTWORTLICHER setzen. Leer = Fallback "der Betreiber dieser App".
VITE_DSGVO_VERANTWORTLICHER=

# CARTO Basemaps API-Key (Build-Zeit-Env). CARTO brennt seit 2026 ein
# "API KEY REQUIRED"-Wasserzeichen in keylose Voyager-Tiles. Key kostenlos per
# Formular: https://carto.com/basemaps/apikey (5 Mio Tiles/Monat, non-commercial).
# Der Key wird ins öffentliche Client-Bundle gebacken — bei CARTO so vorgesehen,
# Keys sind domain-gebunden. Leer = Karte fällt auf Esri World Street Map zurück.
VITE_CARTO_API_KEY=

# Für den dev-Proxy müssen nur die lokalen Supabase Edge Functions laufen:
#   supabase functions serve --env-file .env
# Vite proxed dann /api/* → http://localhost:54321/functions/v1/api/*

# Ohne Docker: setze VITE_API_BASE auf die Production-Edge-Function-URL.
# Dann routed `npm run dev` alle API-Aufrufe direkt dorthin.
# VITE_API_BASE=https://<project>.supabase.co/functions/v1
